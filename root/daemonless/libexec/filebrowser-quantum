#!/bin/sh
# Start filebrowser-quantum; /init has already dropped to the run user.

CONFIG_FILE="${FILEBROWSER_CONFIG:-/config/config.yaml}"

# First boot: write a starter config rather than crash-looping. Anything the
# user mounts at /config/config.yaml wins — this only fires when absent.
if [ ! -f "$CONFIG_FILE" ]; then
    echo "[INFO] no config at ${CONFIG_FILE} — writing a starter config"
    cat > "$CONFIG_FILE" <<'EOF'
# 8080, not upstream's default of 80: this container runs the app as the
# unprivileged `bsd` user, and binding <1024 fails with
# "listen tcp 0.0.0.0:80: bind: permission denied".
http:
  port: 8080
  baseURL: "/"
server:
  cacheDir: "/config/cache"
  sources:
    - path: "/srv"
auth:
  methods:
    password:
      enabled: true
      # Upstream's default, and it must stay 5 here. On first boot the app
      # creates its bootstrap admin user, and a higher minLength rejects that
      # user's own generated password:
      #   [FATAL] store.Users.Save: password must be at least 8 characters long
      # Raise it in your own config *after* first boot, once real accounts exist.
      minLength: 5
      signup: false
EOF
fi

export FILEBROWSER_CONFIG="$CONFIG_FILE"
export FILEBROWSER_DATABASE_PATH="${FILEBROWSER_DATABASE_PATH:-/config/filebrowser.sqlite}"

exec 2>&1

cd /app
exec /app/filebrowser-quantum
